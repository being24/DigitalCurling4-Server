{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dc4-workers-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_ROOM", "class_name": "MatchRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dc4-db",
      "database_id": "2e0c3fd3-9bf7-4428-ac36-a7d982b806d0",
      "migrations_dir": "drizzle"
    }
  ]
}
